      "id": "a1-tr-day",
      "kind": "translate",
      "title": "Мой день",
      "level": "A1",
      "topic": "Каждый день",
      "phrases": [
        {
          "ru": "Я работаю в офисе.",
          "en": "I work in an office.",
          "extra": [
            "works",
            "a"
          ],
          "hint": "После I глагол без -s: I work. Перед гласным звуком — an: an office."
        },
        {
          "ru": "Она любит видеоигры.",
          "en": "She likes video games.",
          "extra": [
            "like",
            "is"
          ],
          "hint": "He / she / it — глагол с -s: she likes."
        },
        {
          "ru": "Мы не смотрим телевизор.",
          "en": "We don't watch TV.",
          "extra": [
            "doesn't",
            "not"
          ],
          "hint": "Отрицание: don't + глагол. Для he / she — doesn't."
        },
        {
          "ru": "Где ты живёшь?",
          "en": "Where do you live?",
          "extra": [
            "does",
            "are"
          ],
          "hint": "Вопрос: Where + do + you + глагол."
        },
        {
          "ru": "У меня есть брат.",
          "en": "I have a brother.",
          "extra": [
            "has",
            "am"
          ],
          "hint": "I have, а he / she has."
        },
        {
          "ru": "Он встаёт в семь.",
          "en": "He gets up at seven.",
          "extra": [
            "get",
            "in"
          ],
          "hint": "Время по часам — at seven. He — gets."
        },
        {
          "ru": "Мой телефон новый.",
          "en": "My phone is new.",
          "extra": [
            "are",
            "me"
          ],
          "hint": "В английском нужен глагол is: My phone is new."
        },
        {
          "ru": "Я умею плавать.",
          "en": "I can swim.",
          "extra": [
            "to",
            "swims"
          ],
          "hint": "После can — глагол без to и без -s."
        }
      ]
    },
